unit Model.Entity.Cidade;

{ ============================================================================
  Entidade CIDADE.

  Guarda tambem NomeEstado e Uf, que vem do JOIN com ESTADO. Sao campos de
  leitura: existem para a tela e o relatorio nao precisarem de uma segunda
  consulta so para mostrar o estado da cidade.
  ============================================================================ }

interface

type
  TCidade = class
  private
    FId: Integer;
    FNome: string;
    FEstadoId: Integer;
    FNomeEstado: string;
    FUf: string;
  public
    property Id: Integer read FId write FId;
    property Nome: string read FNome write FNome;
    property EstadoId: Integer read FEstadoId write FEstadoId;

    { Preenchidos pelo JOIN - nao sao gravados na tabela CIDADE }
    property NomeEstado: string read FNomeEstado write FNomeEstado;
    property Uf: string read FUf write FUf;

    function Descricao: string;
  end;

implementation

uses
  System.SysUtils;

{ "Belo Horizonte/MG" - formato usado no grid e no filtro do relatorio }
function TCidade.Descricao: string;
begin
  Result := Trim(FNome);
  if Trim(FUf) <> '' then
    Result := Result + '/' + Trim(FUf);
end;

end.
