unit View.Principal;

{ ============================================================================
  Tela principal - o "V" do MVC.

  Responsabilidade: menu e nada mais. Ela nao conhece SQL, nao conhece
  FireDAC e nao sabe o que e transacao. Quando o usuario escolhe uma opcao,
  ela apenas abre o formulario correspondente.

  POR QUE O MENU E UM TMainMenu DA VCL E NAO UM dxBarManager?
  Porque o menu e a unica parte desta aplicacao onde a DevExpress nao
  acrescenta nada de funcional - ela acrescentaria so aparencia. Onde a
  DevExpress realmente paga o preco de estar no projeto e nas telas de dado:
  o cxGrid da pesquisa e os editores do cadastro. Menu nativo tambem tem a
  vantagem de continuar funcionando se um dia os pacotes da DevExpress nao
  estiverem instalados na maquina que for abrir o projeto.

  SOBRE O CICLO DE VIDA DOS FORMULARIOS
  So esta tela e criada pelo .dpr. As demais sao criadas na hora em que o
  usuario pede e destruidas quando ele fecha. Em aplicacao de cadastro isso
  evita o problema classico de formulario "sujo": campos preenchidos de uma
  consulta anterior aparecendo na consulta seguinte.
  ============================================================================ }

interface

uses
  System.SysUtils,
  System.Classes,
  Vcl.Forms,
  Vcl.Controls,
  Vcl.Menus,
  Vcl.ComCtrls,
  Vcl.Dialogs,
  Vcl.Graphics;

type
  TfrmPrincipal = class(TForm)
    mnuPrincipal: TMainMenu;
    miSistema: TMenuItem;
    miSair: TMenuItem;
    miCadastros: TMenuItem;
    miCliente: TMenuItem;
    miRelatorios: TMenuItem;
    miRelatorioCliente: TMenuItem;
    stbRodape: TStatusBar;
    procedure FormCreate(Sender: TObject);
    procedure miSairClick(Sender: TObject);
    procedure miClienteClick(Sender: TObject);
    procedure miRelatorioClienteClick(Sender: TObject);
  private
    procedure MostrarCaminhoDoBanco;
  end;

var
  frmPrincipal: TfrmPrincipal;

implementation

uses
  DAO.Conexao,
  View.ClientePesquisa,
  View.Relatorio;

{$R *.dfm}

procedure TfrmPrincipal.FormCreate(Sender: TObject);
begin
  MostrarCaminhoDoBanco;
end;

{ Mostrar o caminho do banco no rodape parece detalhe, mas economiza muito
  suporte: quando alguem diz "os dados sumiram", quase sempre a aplicacao
  esta apontando para outra copia do .FDB. Com o caminho na tela a duvida
  acaba em um segundo. }
procedure TfrmPrincipal.MostrarCaminhoDoBanco;
begin
  try
    stbRodape.SimpleText := 'Banco: ' + TConexao.Obter.CaminhoBanco;
  except
    on E: Exception do
      { Aqui nao se usa raise: a aplicacao continua util mesmo sem banco (o
        usuario ainda consegue ler a mensagem e fechar). Quem realmente
        precisa do banco e cada tela, e cada uma avisa por conta propria. }
      stbRodape.SimpleText := 'Banco indisponivel: ' + E.Message;
  end;
end;

procedure TfrmPrincipal.miSairClick(Sender: TObject);
begin
  Close;
end;

procedure TfrmPrincipal.miClienteClick(Sender: TObject);
var
  LForm: TfrmClientePesquisa;
begin
  LForm := TfrmClientePesquisa.Create(Self);
  try
    LForm.ShowModal;
  finally
    LForm.Free;
  end;
end;

procedure TfrmPrincipal.miRelatorioClienteClick(Sender: TObject);
var
  LForm: TfrmRelatorio;
begin
  LForm := TfrmRelatorio.Create(Self);
  try
    LForm.ShowModal;
  finally
    LForm.Free;
  end;
end;

end.
